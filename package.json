{
	"name": "pi-code-intel",
	"version": "0.1.0",
	"description": "Pi coding agent extension: LSP, sub-agents, code intelligence workflow",
	"type": "module",
	"keywords": [
		"pi-package"
	],
	"main": "./dist/extension.js",
	"files": [
		"dist/",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./dist/extension.js"
		]
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node --experimental-strip-types scripts/copy-assets.ts",
		"dev": "tsc -p tsconfig.build.json --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"smoke": "npm run build && node --experimental-strip-types scripts/mcp-smoke-test.ts",
		"test:foreign": "npm run build && node --experimental-strip-types scripts/foreign-install-test.ts"
	},
	"dependencies": {
		"@sinclair/typebox": "^0.34.0",
		"turndown": "^7.2.2"
	},
	"peerDependencies": {
		"@mariozechner/pi-coding-agent": ">=0.62.0"
	},
	"devDependencies": {
		"@mariozechner/pi-coding-agent": "^0.62.0",
		"@types/node": "^22.0.0",
		"@types/turndown": "^5.0.6",
		"typescript": "^5.7.3",
		"vitest": "^4.1.0"
	},
	"engines": {
		"node": ">=20.6.0"
	},
	"license": "MIT"
}
